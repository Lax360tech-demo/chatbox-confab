{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://chatbox-confab.onrender.com/api/:match*"
    },
    {
      "source": "/socket.io/:match*",
      "destination": "https://chatbox-confab.onrender.com/socket.io/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://chatbox-confab.onrender.com/uploads/:match*"
    },
    {
      "source": "/((?!api|socket\\.io|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
