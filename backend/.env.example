# CONFAB Backend Configuration
PROJECT_NAME="CONFAB"
API_V1_STR="/api"
SECRET_KEY="confab_super_secret_jwt_key_premium_messenger_2026_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=60

# MongoDB Connection (Atlas Connection String)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="confab_db"

# Allowed CORS Origins (comma-separated, without trailing slashes)
CORS_ORIGINS="https://chatbox-confab.vercel.app,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Uploads directory
UPLOAD_DIR="uploads"

# SMS OTP Provider ("mock", "twilio", "fast2sms")
SMS_PROVIDER="mock"
DEMO_OTP="123456"

# STUN / TURN Server Configuration for WebRTC
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
